# App
NODE_ENV=development

# Backend core
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/composition_evaluator
REDIS_URL=redis://redis:6379/0
AUTH_TOKEN_STRATEGY=redis
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
AUTH_CODE_EXPIRE_SECONDS=300
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60
# Optional debug code for local SMS tests only. Keep empty in normal environments.
AUTH_FIXED_CODE=
STORAGE_ROOT=./storage/uploads
STORAGE_PUBLIC_BASE_URL=/storage/uploads
SUBMISSION_MAX_UPLOAD_BYTES=10485760

# Object storage (OSS)
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# Qwen model provider
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
QWEN_TIMEOUT_SECONDS=30

# SMS provider
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=your-sms-access-key-id
SMS_ACCESS_KEY_SECRET=your-sms-access-key-secret
SMS_SIGN_NAME=your-sign-name
SMS_TEMPLATE_CODE=your-template-code

# Casdoor OAuth (Casdoor 统一接入微信登录)
CASDOOR_ENDPOINT=https://door.example.com
CASDOOR_CLIENT_ID=your-casdoor-client-id
CASDOOR_CLIENT_SECRET=your-casdoor-client-secret
CASDOOR_REDIRECT_URI=http://127.0.0.1:3000/login/wechat/callback
CASDOOR_SCOPE=openid profile
CASDOOR_AUTHORIZE_PATH=/login/oauth/authorize
CASDOOR_TOKEN_PATH=/api/login/oauth/access_token
CASDOOR_USERINFO_PATH=/api/userinfo
WECHAT_STATE_EXPIRE_SECONDS=600
WECHAT_BIND_TICKET_EXPIRE_SECONDS=600
WECHAT_TIMEOUT_SECONDS=10

# Frontend
NEXT_PUBLIC_APP_NAME=Composition Evaluator
NEXT_PUBLIC_ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_INTERNAL_URL=http://backend:8000
