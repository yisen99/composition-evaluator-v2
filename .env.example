# App
NODE_ENV=development

# Backend core
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/composition_evaluator
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
AUTH_CODE_EXPIRE_SECONDS=300
# For local development convenience. Set empty in production.
AUTH_FIXED_CODE=123456
STORAGE_ROOT=./storage/uploads
STORAGE_PUBLIC_BASE_URL=/storage/uploads

# Object storage (OSS)
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# Qwen model provider
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
QWEN_TIMEOUT_SECONDS=30

# SMS provider
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=your-sms-access-key-id
SMS_ACCESS_KEY_SECRET=your-sms-access-key-secret
SMS_SIGN_NAME=your-sign-name
SMS_TEMPLATE_CODE=your-template-code

# Frontend
NEXT_PUBLIC_APP_NAME=Composition Evaluator
BACKEND_INTERNAL_URL=http://backend:8000
